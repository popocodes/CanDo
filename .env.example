# Copy this file to .env, fill in what you need, then restart the server. See SETUP.md.

# The https address people use to open CanDo! (needed for email links, Google, Apple, Stripe)
PUBLIC_URL=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CanDo! <you@example.com>"

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Family Plus subscription (Stripe) ---
# PAYWALL=on locks every room except the Bedroom until someone subscribes.
PAYWALL=off
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Hour (0-23) for the daily summary
SUMMARY_HOUR=19
